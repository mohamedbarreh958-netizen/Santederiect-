rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Patient Appointments & Admissions
    match /appointments/{appointmentId} {
      allow read: if isValidId(appointmentId);
      allow create: if isValidId(appointmentId)
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() > 0
        && request.resource.data.patientName.size() <= 200
        && request.resource.data.doctor is string
        && request.resource.data.hospital is string;
      allow update: if isValidId(appointmentId);
      allow delete: if isValidId(appointmentId);
    }

    // Doctor Absences & Replacements
    match /doctorAbsences/{absenceId} {
      allow read: if isValidId(absenceId);
      allow create: if isValidId(absenceId)
        && request.resource.data.doctorName is string
        && request.resource.data.doctorName.size() > 0
        && request.resource.data.doctorName.size() <= 200;
      allow update: if isValidId(absenceId);
      allow delete: if isValidId(absenceId);
    }

    // User Profile & Medical Record
    match /userProfiles/{profileId} {
      allow read: if isValidId(profileId);
      allow create, update: if isValidId(profileId);
      allow delete: if isValidId(profileId);
    }

    // Connection Health Check
    match /test/{testId} {
      allow read, write: if isValidId(testId);
    }
  }
}
